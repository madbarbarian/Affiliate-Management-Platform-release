# ---------------------------------------------------------------------------
# Shared, non-secret defaults. This file IS committed.
#
# Anything here is visible to anyone with the repository, so it must contain
# nothing you would not publish. Secrets go in `.env.local`, which is
# git-ignored — see `.env.local.sample`.
#
# Precedence: real environment variables > .env.local > .env
# ---------------------------------------------------------------------------

# Whose name appears on approvals in the audit trail.
AMP_OPERATOR=owner

# Base of your tracking redirector. Until you host one publicly, links still
# work (they carry the sub-id) but clicks are not counted.
AMP_TRACKING_BASE_URL=https://example.invalid
