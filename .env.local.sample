# ---------------------------------------------------------------------------
# Secrets. Copy to `.env.local`, which is git-ignored and must never be
# committed.
#
# Non-secret defaults belong in `.env` instead — that file IS committed, so
# everyone forking this repository starts from the same baseline.
#
# Precedence: real environment variables > .env.local > .env
# ---------------------------------------------------------------------------

# --- LLM (required when llm.provider = "anthropic") ------------------------
ANTHROPIC_API_KEY=

# --- Console authentication -------------------------------------------------
# The approval console requires this. `amp init` generates one for you; if you
# copied this file by hand instead, put a value here. Leaving it blank means
# the console generates a new token every restart, so the URL you bookmarked
# stops working — and if you have put a public domain in front of the daemon so
# tracking links resolve, that domain reaches the console too, not just /go/.
#
# To make one:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
AMP_CONSOLE_TOKEN=

# A second operator gets their own passphrase and their own name, listed under
# `console.operators` in platform.config.yaml. Sharing one passphrase means the
# audit log records every approval against the owner, whoever pressed it — and
# that cannot be corrected later.
# AMP_CONSOLE_TOKEN_MIDORI=

# --- Channel credentials ----------------------------------------------------
# Only needed for channels you actually enable in platform.config.yaml.
# The key format is AMP_CHANNEL_<CHANNEL_ID_UPPERCASED>_<NAME>
AMP_CHANNEL_THREADS_TOKEN=
AMP_CHANNEL_THREADS_USER_ID=
# AMP_CHANNEL_X_TOKEN=
# AMP_CHANNEL_NOTE_TOKEN=
# AMP_CHANNEL_YOUTUBE_TOKEN=

# --- Cloudflare (hand-run deploys only) -------------------------------------
# Not a secret, but it lives here rather than in `.env` because `.env` is
# committed: an id written there would ship to everyone who forks.
#
# The Deploy to Cloudflare button creates a database and fills this in for you,
# and then you never need this variable. Set it only if you run `npm run deploy`
# yourself, after `npx wrangler d1 create amp`.
# AMP_D1_DATABASE_ID=

# --- Affiliate network credentials -----------------------------------------
# AMP_NETWORK_<NETWORK_ID_UPPERCASED>_TOKEN
# Networks read from CSV exports need no credentials at all.
AMP_NETWORK_DEMO_TOKEN=
