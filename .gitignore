node_modules/
dist/
release/

# Secrets. `.env` holds shared non-secret defaults and IS committed;
# `.env.local` holds keys and tokens and never is.
.env.local
.env.*.local

# Default runtime data directory (per-licensee operating state), including any
# affiliate reports dropped there for the csv network adapter.
.amp/
*.log

# Your own configuration. Created by `amp init` from the shipped example.
#
# COMMIT IT. On Cloudflare the build bundles this file into the Worker,
# which has no filesystem to read it from - an uncommitted config is one
# the deploy never sees, and it comes up on the example instead.
#
# It carries no secrets by design: it names environment variables, and the
# values live in Cloudflare's dashboard or in `.env.local`.
#
# platform.config.yaml
# platform.config.yml
# platform.config.json

# Claude Design のシード出力（エディタ同梱・2.5MB）。ソースは .dc.html のほう。
# canvas.html は例外で、こちらが `npm run build:canvas` で描いた俯瞰版。
# 生成物だが、GitHub でそのまま開けることが目的なのでコミットする。
docs/_proposed/design/*.html
!docs/_proposed/design/*.dc.html
!docs/_proposed/design/canvas.html

# Claude Design のシード出力（エディタ同梱・2.5MB）。ソースは .dc.html のほう。
docs/_proposed/design/onboarding/*.html
!docs/_proposed/design/onboarding/*.dc.html
!docs/_proposed/design/onboarding/canvas.html

# Generated by scripts/bundle-worker.ts before every deploy.
src/worker/bundled.generated.ts

# Generated by scripts/deploy-worker.ts. Carries the D1 database id of whoever
# deployed, which is why it is not the file that ships.
wrangler.generated.jsonc

# Output of the release tests. Never committed.
release-test-output/
